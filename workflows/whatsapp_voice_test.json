          "conditions": [
            {
              "id": "fd285e0d-111b-5fa8-a3eb-e9f7f1c260bb",
              "leftValue": "={{ $('Validate Demo Setup').item.json.mode === 'preview' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "1f83a2a2-a4cf-5903-a8ee-9b02ac8438c6",
      "name": "Save WhatsApp Preview",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        1320,
        -300
