    {
      "id": "c78c9caa-4a4f-5458-a26b-04b3440c3e38",
      "name": "Upload Failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        240
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: {channel:'whatsapp',status:'failed',stage:'upload',send_attempted:false,next_step:'Inspect Upload MP3 to Meta and check the token, API version and Phone Number ID.'} };"
