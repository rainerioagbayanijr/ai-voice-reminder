        "jsonOutput": "{\n  \"input_mode\": \"csv\",\n  \"mode\": \"preview\",\n  \"first_name\": \"Alex\",\n  \"agent_name\": \"Rain from Test Company\",\n  \"bank_name\": \"Test Bank\",\n  \"due_date\": \"2026-11-15\",\n  \"test_recipient\": \"\",\n  \"phone_number_id\": \"\",\n  \"graph_api_version\": \"\",\n  \"last_hello_at_utc\": \"\",\n  \"meta_test_number_confirmed\": false,\n  \"recipient_verified\": false\n}",
