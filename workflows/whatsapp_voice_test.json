    {
      "id": "497d1cab-92aa-5c95-9e4c-2848aaed5d21",
      "name": "WhatsApp Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4180,
        -200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// API acceptance is not a delivery/read receipt. Never retry an ambiguous send.\nconst response = $json;\nconst messageId = response.messages?.[0]?.id;\nconst accepted = !response.error && typeof messageId === 'string' && messageId.startsWith('wamid.');\nreturn { json: {\n  channel: 'whatsapp',\n  status: accepted ? 'submitted' : 'unknown',\n  message_id: accepted ? messageId : null,\n  automatic_retry: false,\n  next_step: accepted\n    ? 'Check your verified test phone. Meta accepted this message; delivery and playback are not confirmed.'\n    : 'Inspect the Send WhatsApp Audio node and your test phone before any manual retry. Submission may have succeeded.'\n}};\n"
      }
    },
    {
      "id": "37130ec0-50ad-5806-a366-e873b1a2c61b",
      "name": "Read Me - Test Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -480
      ],
      "parameters": {
        "content": "## WhatsApp Voice Test\n\nDefault: **CSV + preview**. Each eligible CSV row gets a recording. All sends use the verified test phone.\n\nFor live testing, follow **docs/whatsapp-test.md**. Use Meta's supplied test sender and your own verified recipient. Send Hello first, then enter its UTC time in Demo Settings.\n\nSelect the same Header Auth credential on Upload and Send: `Authorization: Bearer <token>`. Never paste the token into Demo Settings.\n\nEdit agent and bank in Demo Settings. CSV supplies customer names and dates. Set input_mode=single for Alex only.\n\nManual test only. Duplicate CSV IDs/due dates are skipped within each batch. Every send-mode run is a fresh batch; don't rerun unknown results blindly.",
        "width": 660,
        "height": 380
      }
    }
  ],
