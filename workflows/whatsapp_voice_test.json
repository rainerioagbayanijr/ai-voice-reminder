        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "ed3094b4-78d5-5abf-96fc-c9dad5b0a818",
      "name": "Upload Accepted",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ed3094b4-78d5-5abf-96fc-c9dad5b0a818",
              "leftValue": "={{ !$json.error && typeof $json.id === 'string' && /^[0-9]{1,64}$/.test($json.id) }}",
