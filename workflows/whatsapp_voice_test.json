    {
      "id": "ca444e59-ef56-59bc-99ff-1598a31c162f",
      "name": "Check Window and Prepare Audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        -100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Recheck after synthesis/upload; neither TTS nor the upload opens a reply window.\nconst config = $('Validate Demo Setup').item.json;\nconst age = Date.now() - Date.parse(config.last_hello_at_utc);\nif (!Number.isFinite(age) || age < 0 || age >= 24 * 60 * 60 * 1000 - 30000) {\n  throw new Error('Reply window expired during preparation. No send was attempted. Send a fresh Hello and run again.');\n}\nif (typeof $json.id !== 'string' || !/^[0-9]{1,64}$/.test($json.id)) {\n  throw new Error('Meta did not return a valid uploaded media ID. No send was attempted.');\n}\nreturn { json: {\n  messaging_product: 'whatsapp',\n  recipient_type: 'individual',\n  to: config.test_recipient,\n  type: 'audio',\n  audio: { id: $json.id }\n}};\n"
      }
    },
    {
      "id": "d4614c75-4383-5f34-a0e5-4c727a107cc7",
      "name": "Send WhatsApp Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        -100
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/' + $('Validate Demo Setup').item.json.graph_api_version + '/' + $('Validate Demo Setup').item.json.phone_number_id + '/messages' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    },
    {
      "id": "497d1cab-92aa-5c95-9e4c-2848aaed5d21",
      "name": "WhatsApp Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        -100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// API acceptance is not a delivery/read receipt. Never retry an ambiguous send.\nconst response = $json;\nconst messageId = response.messages?.[0]?.id;\nconst accepted = !response.error && typeof messageId === 'string' && messageId.startsWith('wamid.');\nreturn { json: {\n  channel: 'whatsapp',\n  status: accepted ? 'submitted' : 'unknown',\n  message_id: accepted ? messageId : null,\n  automatic_retry: false,\n  next_step: accepted\n    ? 'Check your verified test phone. Meta accepted this message; delivery and playback are not confirmed.'\n    : 'Inspect the Send WhatsApp Audio node and your test phone before any manual retry. Submission may have succeeded.'\n}};\n"
      }
    },
    {
      "id": "37130ec0-50ad-5806-a366-e873b1a2c61b",
      "name": "Read Me - Test Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -480
      ],
      "parameters": {
        "content": "## WhatsApp Voice Test\n\nDefault: **preview**. Run now to save an MP3.\n\nFor live testing, follow **docs/whatsapp-test.md**. Use Meta's supplied test sender and your own verified recipient. Send Hello first, then enter its UTC time in Demo Settings.\n\nSelect the same Header Auth credential on Upload and Send: `Authorization: Bearer <token>`. Never paste the token into Demo Settings.\n\nManual test only. No automatic inbound trigger, schedule, paid provider, or customer CSV. `submitted` means API accepted, not delivered. Each send-mode run is a new attempt; don't rerun an unknown result blindly.",
        "width": 660,
        "height": 380
      }
    }
  ],
