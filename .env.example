# Generate unique secrets: python -c "import secrets; print(secrets.token_hex(32))"
REMINDER_API_KEY=replace-with-random-64-character-hex-secret
N8N_ENCRYPTION_KEY=replace-with-another-random-64-character-hex-secret
# Use hex to avoid URL escaping in the Compose DATABASE_URL.
POSTGRES_PASSWORD=replace-with-random-hex-password
DRY_RUN=true
TEST_RECIPIENT=preview@example.com
# Set only after independently verifying that you control the test inbox.
TEST_RECIPIENT_VERIFIED=false
SENDER_EMAIL=support@example.com
VOICE=fil-PH-BlessicaNeural
ALLOWED_VOICES=en-US-JennyNeural,en-US-AriaNeural,fil-PH-BlessicaNeural
LANGUAGE=fil
# To switch back to English, use VOICE=en-US-JennyNeural and LANGUAGE=en.
RATE=-15%
VOLUME=-5%
# Configure SMTP host, port, TLS, username and password in the n8n SMTP credential.
# For standalone Python tracking (not required for independent TTS-only use):
# DATABASE_URL=postgresql://reminder:password@localhost:5432/reminders
