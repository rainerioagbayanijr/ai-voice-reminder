# Generate unique secrets: python -c "import secrets; print(secrets.token_hex(32))"
REMINDER_API_KEY=replace-with-random-64-character-hex-secret
N8N_ENCRYPTION_KEY=replace-with-another-random-64-character-hex-secret
# Use hex to avoid URL escaping in the Compose DATABASE_URL.
POSTGRES_PASSWORD=replace-with-random-hex-password
DRY_RUN=true
TEST_RECIPIENT=preview@example.com
# Set only after independently verifying that you control the test inbox.
TEST_RECIPIENT_VERIFIED=false
SENDER_EMAIL=support@example.com
VOICE=fil-PH-BlessicaNeural
# Edge remains active. No ElevenLabs request is made unless explicitly selected.
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
# Optional voice allowlist: blank means only ELEVENLABS_VOICE_ID is allowed.
ELEVENLABS_ALLOWED_VOICES=
# Optional two-letter language code for models that support language enforcement.
ELEVENLABS_LANGUAGE_CODE=
ELEVENLABS_SPEED=0.85
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ALLOWED_VOICES=en-US-JennyNeural,en-US-AriaNeural,fil-PH-BlessicaNeural
LANGUAGE=fil
# To switch back to English, use VOICE=en-US-JennyNeural and LANGUAGE=en.
# Edge prosody defaults; ElevenLabs uses ELEVENLABS_SPEED and neutral volume.
RATE=-15%
VOLUME=-5%
AUDIO_CONVERSION_TIMEOUT_SECONDS=10
# WhatsApp send routing is independently guarded by the backend.
# Digits with country code, e.g. your OWN verified test phone. Never use sample CSV phones.
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_RECIPIENT_VERIFIED=false
# Keep false until customer numbers and per-row incoming-message timestamps are verified.
WHATSAPP_CUSTOMER_ROUTING_ENABLED=false
# Shared tracking defaults (email and WhatsApp). Keep tenant stable after first send.
TENANT_ID=fictional-demo
LEASE_SECONDS=600
MAX_ATTEMPTS=3
RETRY_DELAY_SECONDS=300
# Configure SMTP host, port, TLS, username and password in the n8n SMTP credential.
# For standalone Python tracking (not required for independent TTS-only use):
# DATABASE_URL=postgresql://reminder:password@localhost:5432/reminders
# Meta webhook settings (App Secret is NOT the access token).
# Keep manual until Meta callback + messages subscription have been verified.
WHATSAPP_WINDOW_SOURCE=manual
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
